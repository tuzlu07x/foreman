              {
                "secret": "trello-token",
                "label": "Trello token",
                "where_to_get": "https://trello.com/power-ups/admin",
                "format_hint": "long token, usually starting with ATTA",
                "setup_steps": [
                  "On the same API key page, follow the Token link and allow access",
                  "Paste the token Trello shows"
                ]
              }
            ]
          },
          "default_access_level": "read-only",
          "access_levels": {
            "read-only": {
              "description": "Reads only: every tool that could change something is refused.",
