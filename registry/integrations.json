{
  "version": 1,
  "integrations": [
    {
      "id": "github",
      "name": "GitHub",
      "aliases": [
        "gh"
      ],
      "category": "code",
      "description": "Issues, pull requests, code search and repositories on GitHub.",
      "homepage": "https://github.com/github/github-mcp-server",
      "used_by_agents": [
        "claude-code",
        "codex"
      ],
      "health_check": {
        "tool": "get_me"
      },
      "variants": [
        {
          "id": "official",
          "label": "GitHub hosted server · token",
          "server": "github",
          "recommended": true,
          "description": "GitHub's hosted MCP server with a fine-grained personal access token. Lockdown mode is on.",
          "auth": {
            "kind": "secrets",
            "fields": [
              {
                "secret": "github-pat",
                "label": "GitHub personal access token",
                "where_to_get": "https://github.com/settings/personal-access-tokens/new",
                "format_hint": "github_pat_… (fine-grained, recommended) or a classic token",
                "pattern": "^(github_pat_[A-Za-z0-9_]{20,255}|gh[p]_[A-Za-z0-9]{30,255})$",
                "setup_steps": [
                  "Open github.com/settings/personal-access-tokens/new (fine-grained token)",
                  "Resource owner: you or your organization; Repository access: only the repositories agents need",
                  "Read-only use: Contents, Issues, Pull requests, Metadata → Read-only",
                  "Read + write use: also Issues and Pull requests → Read and write (Contents → Read and write only if agents push)",
                  "Generate the token and paste it here — Foreman stores it encrypted and never shows it to agents"
                ]
              }
            ]
          },
          "default_access_level": "read-only",
          "access_levels": {
            "read-only": {
              "description": "Reads only: every tool that could change something is refused.",
              "tools": {
                "deny": [
                  "create_*",
                  "update_*",
                  "delete_*",
                  "merge_*",
                  "push_*",
                  "fork_*",
                  "add_*",
                  "remove_*",
                  "*_write",
                  "actions_run_trigger",
                  "dismiss_*",
                  "mark_*",
                  "manage_*",
                  "request_*",
                  "assign_*",
                  "submit_*",
                  "rerun_*",
                  "cancel_*",
                  "star_*",
                  "unstar_*"
                ]
              },
              "headers": {
                "X-MCP-Readonly": "true"
              }
            },
            "read-write": {
              "description": "Reads run freely; writes ask; merges, pushes and repository changes need a human every time; deletes are refused.",
              "tools": {
                "confirm": [
                  "merge_*",
                  "push_files",
                  "*_repository"
                ],
                "deny": [
                  "delete_*"
                ]
              }
            }
          },
          "revoke_url": "https://github.com/settings/personal-access-tokens",
          "notes": "GitHub's hosted server does not offer OAuth dynamic client registration, so it takes a token."
        },
        {
          "id": "docker",
          "label": "Local Docker · token",
          "server": "github-docker",
          "description": "The same server run locally in Docker from a pinned image (GitHub Enterprise Server too).",
          "auth": {
            "kind": "secrets",
            "fields": [
              {
                "secret": "github-pat",
                "label": "GitHub personal access token",
                "where_to_get": "https://github.com/settings/personal-access-tokens/new",
                "format_hint": "github_pat_… (fine-grained, recommended) or a classic token",
                "pattern": "^(github_pat_[A-Za-z0-9_]{20,255}|gh[p]_[A-Za-z0-9]{30,255})$",
                "setup_steps": [
                  "Open github.com/settings/personal-access-tokens/new (fine-grained token)",
                  "Resource owner: you or your organization; Repository access: only the repositories agents need",
                  "Read-only use: Contents, Issues, Pull requests, Metadata → Read-only",
                  "Read + write use: also Issues and Pull requests → Read and write (Contents → Read and write only if agents push)",
                  "Generate the token and paste it here — Foreman stores it encrypted and never shows it to agents"
                ]
              }
            ]
          },
          "default_access_level": "read-only",
          "access_levels": {
            "read-only": {
              "description": "Reads only: every tool that could change something is refused.",
              "tools": {
                "deny": [
                  "create_*",
                  "update_*",
                  "delete_*",
                  "merge_*",
                  "push_*",
                  "fork_*",
                  "add_*",
                  "remove_*",
                  "*_write",
                  "actions_run_trigger",
                  "dismiss_*",
                  "mark_*",
                  "manage_*",
                  "request_*",
                  "assign_*",
                  "submit_*",
                  "rerun_*",
                  "cancel_*",
                  "star_*",
                  "unstar_*"
                ]
              },
              "env": {
                "GITHUB_READ_ONLY": "1"
              }
            },
            "read-write": {
              "description": "Reads run freely; writes ask; merges, pushes and repository changes need a human every time; deletes are refused.",
              "tools": {
                "confirm": [
                  "merge_*",
                  "push_files",
                  "*_repository"
                ],
                "deny": [
                  "delete_*"
                ]
              }
            }
          },
          "revoke_url": "https://github.com/settings/personal-access-tokens"
        }
      ]
    },
    {
      "id": "gitlab",
      "name": "GitLab",
      "aliases": [
        "gl"
      ],
      "category": "code",
      "description": "Issues, merge requests, pipelines and search on GitLab.com or a self-managed instance.",
      "homepage": "https://docs.gitlab.com/user/model_context_protocol/mcp_server/",
      "used_by_agents": [
        "claude-code",
        "codex"
      ],
      "variants": [
        {
          "id": "official",
          "label": "GitLab built-in server · sign in",
          "server": "gitlab",
          "recommended": true,
          "description": "GitLab's own MCP server (Beta, Premium and Ultimate); you sign in in the browser.",
          "auth": {
            "kind": "oauth"
          },
          "default_access_level": "read-only",
          "access_levels": {
            "read-only": {
              "description": "Reads only: every tool that could change something is refused.",
              "tools": {
                "deny": [
                  "create_*",
                  "update_*",
                  "delete_*",
                  "manage_*",
                  "merge_*",
                  "post_*",
                  "retry_*",
                  "cancel_*",
                  "play_*",
                  "push_*",
                  "fork_*",
                  "publish_*",
                  "upload_*",
                  "approve_*",
                  "unapprove_*",
                  "add_*",
                  "remove_*"
                ]
              }
            },
            "read-write": {
              "description": "Reads run freely; writes ask; merges need a human every time; deletes are refused.",
              "tools": {
                "confirm": [
                  "merge_*"
                ],
                "deny": [
                  "delete_*"
                ]
              }
            }
          },
          "health_check": {
            "tool": "get_mcp_server_version"
          },
          "revoke_url": "https://gitlab.com/-/user_settings/applications",
          "notes": "Self-managed instances can switch off dynamic client registration; use the community variant there."
        },
        {
          "id": "community",
          "label": "Community server · token",
          "server": "gitlab-community",
          "description": "zereight/gitlab-mcp with a personal access token; any tier, self-managed too.",
          "auth": {
            "kind": "secrets",
            "fields": [
              {
                "secret": "gitlab-pat",
                "label": "GitLab personal access token",
                "where_to_get": "https://gitlab.com/-/user_settings/personal_access_tokens",
                "format_hint": "usually starts with glpat-",
                "setup_steps": [
                  "Open your GitLab → Edit profile → Access tokens → Add new token",
                  "Read-only use: scope read_api. Read + write use: scope api",
                  "Set an expiry date, create the token and paste it here"
                ]
              }
            ]
          },
          "default_access_level": "read-only",
          "access_levels": {
            "read-only": {
              "description": "Reads only: every tool that could change something is refused.",
              "tools": {
                "deny": [
                  "create_*",
                  "update_*",
                  "delete_*",
                  "manage_*",
                  "merge_*",
                  "post_*",
                  "retry_*",
                  "cancel_*",
                  "play_*",
                  "push_*",
                  "fork_*",
                  "publish_*",
                  "upload_*",
                  "approve_*",
                  "unapprove_*",
                  "add_*",
                  "remove_*"
                ]
              },
              "env": {
                "GITLAB_PERMISSION_MODE": "readonly",
                "GITLAB_READ_ONLY_MODE": "true"
              }
            },
            "read-write": {
              "description": "Reads run freely; writes ask; merges and pushes need a human every time; deletes are refused.",
              "tools": {
                "confirm": [
                  "merge_*",
                  "push_files"
                ],
                "deny": [
                  "delete_*"
                ]
              }
            }
          },
          "revoke_url": "https://gitlab.com/-/user_settings/personal_access_tokens"
        }
      ]
    },
    {
