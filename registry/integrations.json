        {
          "id": "official",
          "label": "Trello official server · sign in (unverified)",
          "server": "trello",
          "description": "Atlassian's hosted Trello server. Unverified with Foreman: sign-in may fail.",
          "auth": {
            "kind": "oauth"
          },
          "default_access_level": "read-only",
          "access_levels": {
            "read-only": {
              "description": "Best effort: the official server's tool names are not published, so writes are refused by name; anything unmatched still asks.",
              "tools": {
                "deny": [
                  "*create*",
                  "*update*",
                  "*add*",
                  "*move*",
                  "*archive*",
                  "*delete*",
                  "*remove*",
                  "*attach*",
                  "*detach*",
                  "*copy*",
                  "*Create*",
                  "*Update*",
                  "*Add*",
                  "*Move*",
                  "*Archive*",
                  "*Delete*",
                  "*Remove*",
                  "*Attach*",
                  "*Detach*",
                  "*Copy*"
                ]
              }
            },
            "read-write": {
              "description": "Reads run freely; writes ask; deletes are refused.",
              "tools": {
                "deny": [
                  "*delete*",
                  "*Delete*"
                ]
              }
            }
          },
          "revoke_url": "https://trello.com/my/account"
        }
